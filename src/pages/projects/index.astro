---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { u } from '../../lib/url';
const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projetos" current="projects" description="Todos os projetos de design.">
  <div class="crumbs"><a href={u('/')}>Início</a> / Projetos</div>
  <div class="section-head"><h1 class="title" style="font-family:var(--head);font-size:clamp(2.4rem,7vw,4.4rem)">Projetos</h1></div>
  <div class="grid">
    {projects.map((p) => (
      <Card href={u(`/projects/${p.id}/`)} title={p.data.title} image={p.data.cover} meta={`${p.data.category} · ${p.data.year}`} />
    ))}
  </div>
</Base>
